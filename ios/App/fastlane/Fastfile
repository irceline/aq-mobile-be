default_platform(:ios)

fastlane_require 'dotenv'

before_all do
  Dotenv.overload '../../../.env'
end

# Dedicated per-run keychain, so signing does not depend on the state of the login keychain.
KEYCHAIN = "belair-ci"

def delete_ci_keychain
  delete_keychain(name: KEYCHAIN) if File.exist?(File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db"))
end

after_all { |_lane| delete_ci_keychain }
error { |_lane, _exception| delete_ci_keychain }

platform :ios do
  team_id = CredentialsManager::AppfileConfig.try_fetch_value(:team_id)
  app_identifier = CredentialsManager::AppfileConfig.try_fetch_value(:app_identifier)

  lane :configure do
    ensure_env_vars(
      env_vars: [
        'KEYCHAIN_PASSWORD',
        'MATCH_PASSWORD',
        'MATCH_REPO_PASSWORD',
      ]
    )

    delete_ci_keychain
    create_keychain(
      name: KEYCHAIN,
      password: ENV["KEYCHAIN_PASSWORD"],
      unlock: true,
      timeout: 3600,
      lock_when_sleeps: false,
      add_to_search_list: false,
      default_keychain: false,
    )
    # Search ours first: the same signing identity may also exist in other keychains on the machine.
    keychain_path = File.expand_path("~/Library/Keychains/#{KEYCHAIN}-db")
    others = sh("security", "list-keychains", "-d", "user", log: false).shellsplit - [keychain_path]
    sh("security", "list-keychains", "-d", "user", "-s", keychain_path, *others, log: false)

    match(
      type: "appstore",
      app_identifier: app_identifier,
      team_id: team_id,
      readonly: true,
      keychain_name: KEYCHAIN,
      keychain_password: ENV["KEYCHAIN_PASSWORD"],
    )
  end

  lane :build do
    configure

    sh("pod install --repo-update")

    build_app(
      scheme: "App",
      workspace: "App.xcworkspace",
      include_bitcode: false,
      export_method: "app-store",
      clean: true,
      output_name: "belair.ipa",
    )
  end

  lane :app_store_connection do
    app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_KEY_ISSUER_ID"],
      key_content: ENV["APPLE_API_KEY_P8_BASE64"],
      duration: 1200,
      in_house: false,
      is_key_content_base64: true,
    )
  end

  lane :deploy_testflight do
    ensure_env_vars(
      env_vars: [
        'KEYCHAIN_PASSWORD',
        'MATCH_PASSWORD',
        'APPLE_API_KEY_ID',
        'APPLE_API_KEY_ISSUER_ID',
        'APPLE_API_KEY_P8_BASE64',
      ]
    )

    app_store_connection

    app_store_connect_api_key(
      key_id: ENV["APPLE_API_KEY_ID"],
      issuer_id: ENV["APPLE_API_KEY_ISSUER_ID"],
      key_content: ENV["APPLE_API_KEY_P8_BASE64"],
      duration: 1200,
      in_house: false,
      is_key_content_base64: true,
    )

    upload_to_testflight(
      skip_waiting_for_build_processing: true,
    )
  end

  lane :deploy do
    build
    deploy_testflight
  end
end
